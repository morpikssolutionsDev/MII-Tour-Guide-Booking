# Local development: a SQLite file in the project root.
DATABASE_URL=file:local.db
# Production (Vercel): libsql://<db>.turso.io plus a Turso token.
DATABASE_AUTH_TOKEN=

# Any long random string. Generate one with: npx auth secret
AUTH_SECRET=change-me

# `local` writes uploads to .data/uploads (served with role checks); `vercel-blob` needs BLOB_READ_WRITE_TOKEN.
STORAGE_DRIVER=local
BLOB_READ_WRITE_TOKEN=

# Used to build absolute links, e.g. the tourist feedback URL.
APP_BASE_URL=http://localhost:3000

# Payment confirmation (06). Unset or anything but "true" = off: bookings are confirmed and
# recorded as paid by the system at creation (docs/spec/12 BR-12-P1).
PAYMENT_CONFIRMATION=

# Team email on new bookings (docs/spec/12 §4). On/off and recipients are set in Pengaturan → Email.
# Local testing: run an SMTP sink (e.g. `npx maildev`) and use localhost / 1025.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="TMII Tour Guide" <noreply@example.com>

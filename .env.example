# Local development: a SQLite file in the project root.
DATABASE_URL=file:local.db
# Production (Vercel): libsql://<db>.turso.io plus a Turso token.
DATABASE_AUTH_TOKEN=

# Any long random string. Generate one with: npx auth secret
AUTH_SECRET=change-me

# `local` writes uploads to .data/uploads (served with role checks); `vercel-blob` needs BLOB_READ_WRITE_TOKEN.
STORAGE_DRIVER=local
BLOB_READ_WRITE_TOKEN=

# Used to build absolute links, e.g. the tourist feedback URL.
APP_BASE_URL=http://localhost:3000
